generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

// ENUMS
enum UserRole {
  FARMER
  BUYER
  SUPPLIER
  TRANSPORTER
  VET
  COOPERATIVE
  FINANCIER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  ACTIVE
  SOLD_OUT
  INACTIVE
}

enum OrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  REJECTED
  AWAITING_PAYMENT
  PAID
  OUT_FOR_DELIVERY
  DELIVERED
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum EscrowStatus {
  AWAITING_FUNDS
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CONFIRMED
  FAILED
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  PHONE_VERIFICATION
}

enum NotificationType {
  ORDER
  PAYMENT
  ESCROW
  DELIVERY
  MESSAGE
  REVIEW
  SYSTEM
  VERIFICATION
}

// IDENTITY

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  phone              String?             @unique
  passwordHash       String
  role               UserRole
  isEmailVerified    Boolean             @default(false)
  isPhoneVerified    Boolean             @default(false)
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  isActive           Boolean             @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  profile         Profile?
  farms           Farm[]
  listings        Listing[]        @relation("SellerListings")
  ordersAsBuyer   Order[]          @relation("BuyerOrders")
  reviewsGiven    Review[]         @relation("ReviewsGiven")
  reviewsReceived Review[]         @relation("ReviewsReceived")
  notifications   Notification[]
  otps            Otp[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  deliveries      Delivery[]       @relation("TransporterDeliveries")
  conversationsA  Conversation[]   @relation("ParticipantOne")
  conversationsB  Conversation[]   @relation("ParticipantTwo")
  messages        Message[]
  cooperativeMemberships CooperativeMember[]

  @@index([role])
  @@map("users")
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  businessName String?
  avatarUrl    String?
  bio          String?
  address      String?
  state        String?
  lga          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Otp {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
  @@map("otps")
}

// FARMER

model Farm {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  address     String?
  state       String?
  lga         String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings Listing[]

  @@index([ownerId])
  @@map("farms")
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  listings     Listing[]
  marketPrices MarketPrice[]

  @@map("categories")
}

model Listing {
  id                String        @id @default(uuid())
  sellerId          String
  seller            User          @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  farmId            String?
  farm              Farm?         @relation(fields: [farmId], references: [id], onDelete: SetNull)
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id])
  productName       String
  description       String?
  quantity          Decimal       @db.Decimal(12, 2)
  unit              String
  price             Decimal       @db.Decimal(12, 2)
  minOrderQuantity  Decimal       @default(1) @db.Decimal(12, 2)
  location          String?
  state             String?
  lga               String?
  availabilityDate  DateTime?
  status            ListingStatus @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  images     ListingImage[]
  orderItems OrderItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([state, lga])
  @@index([status])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_images")
}

model MarketPrice {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  productName String
  state       String
  avgPrice    Decimal  @db.Decimal(12, 2)
  unit        String
  recordedAt  DateTime @default(now())

  @@index([categoryId, state])
  @@map("market_prices")
}

// ORDERS, PAYMENTS, ESCROW & DELIVERY

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  status          OrderStatus @default(PENDING_ACCEPTANCE)
  totalAmount     Decimal     @db.Decimal(12, 2)
  deliveryAddress String
  deliveryState   String?
  deliveryLga     String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items    OrderItem[]
  payment  Payment?
  escrow   EscrowTransaction?
  delivery Delivery?
  review   Review?

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  sellerId  String
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId            String
  amount             Decimal       @db.Decimal(12, 2)
  provider           String // "paystack" | "mock"
  providerReference  String        @unique
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime?
  rawResponse        Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([providerReference])
  @@map("payments")
}

model EscrowTransaction {
  id             String       @id @default(uuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(12, 2)
  status         EscrowStatus @default(AWAITING_FUNDS)
  heldAt         DateTime?
  releasedAt     DateTime?
  refundedAt     DateTime?
  disputeReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("escrow_transactions")
}

model Delivery {
  id              String         @id @default(uuid())
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transporterId   String?
  transporter     User?          @relation("TransporterDeliveries", fields: [transporterId], references: [id])
  status          DeliveryStatus @default(PENDING)
  pickupAddress   String?
  deliveryAddress String
  confirmedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("deliveries")
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([revieweeId])
  @@map("reviews")
}

// MESSAGING
model Conversation {
  id               String    @id @default(uuid())
  participantOneId String
  participantOne   User      @relation("ParticipantOne", fields: [participantOneId], references: [id])
  participantTwoId String
  participantTwo   User      @relation("ParticipantTwo", fields: [participantTwoId], references: [id])
  listingId        String?
  createdAt        DateTime  @default(now())

  messages Message[]

  @@unique([participantOneId, participantTwoId, listingId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// CO-OPERATIVE

model CooperativeMember {
  id             String   @id @default(uuid())
  cooperativeId  String
  memberId       String
  member         User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  joinedAt       DateTime @default(now())

  @@unique([cooperativeId, memberId])
  @@map("cooperative_members")
}

// NOTIFICATIONS

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}