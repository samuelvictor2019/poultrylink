    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^7.8.0",
    "react-hook-form": "^7.53.0",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "nodemon backend/server.js",
    "start": "npm run prisma:deploy && npm run seed && node backend/server.js",
    "prisma:generate": "prisma generate --config backend/prisma7.config.ts",
    "prisma:migrate": "prisma migrate dev --config backend/prisma7.config.ts",
    "prisma:deploy": "prisma migrate deploy --config backend/prisma7.config.ts",
    "prisma:studio": "prisma studio --config backend/prisma7.config.ts",
    "seed": "node database/seeds/seed.js",
    "lint": "eslint backend/src",
    "build": "npm run prisma:generate"
  },
